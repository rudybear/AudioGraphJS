{
  "extensionsUsed": ["KHR_audio_graph"],
  "extensions": {
    "KHR_audio_graph": {
      "schemaVersion": "0.1",
      "graphs": [
        {
          "name": "spatial-emitter",
          "nodes": [
            { "kind": "source", "params": { "data": { "oscillator": { "type": 1, "frequency": 330, "pulseWidth": 0.25 } }, "when": 0, "duration": 800 } },
            { "kind": "emitter", "params": { "emitterType": "spatial", "gain": 0.9, "spatialProperties": { "spatializationModel": "equalpower", "attenuation": { "distanceModel": "linear", "refDistance": 1, "maxDistance": 1000, "rolloffFactor": 1 } } } }
          ],
          "connections": [ { "from": { "node": 0 }, "to": { "node": 1 } } ]
        }
      ]
    }
  }
}

