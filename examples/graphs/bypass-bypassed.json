{
  "nodes": [
    {
      "id": "osc",
      "kind": "oscillator",
      "params": {
        "type": "sawtooth",
        "frequency": 440,
        "startTime": 0
      }
    },
    {
      "id": "lp",
      "kind": "biquad-filter",
      "params": {
        "type": "lowpass",
        "frequency": 1000,
        "Q": 0.7,
        "bypass": true
      }
    },
    {
      "id": "amp",
      "kind": "gain",
      "params": {
        "gain": 0.3
      }
    },
    {
      "id": "emit",
      "kind": "emitter",
      "params": {
        "emitterType": "global",
        "gain": 1
      }
    }
  ],
  "connections": [
    {
      "from": {
        "node": "osc"
      },
      "to": {
        "node": "lp"
      }
    },
    {
      "from": {
        "node": "lp"
      },
      "to": {
        "node": "amp"
      }
    },
    {
      "from": {
        "node": "amp"
      },
      "to": {
        "node": "emit"
      }
    }
  ]
}