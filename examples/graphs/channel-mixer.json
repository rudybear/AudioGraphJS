{
  "nodes": [
    {
      "id": "osc",
      "kind": "oscillator",
      "params": {
        "type": "sine",
        "frequency": 440,
        "startTime": 0
      }
    },
    {
      "id": "mix",
      "kind": "channel-mixer",
      "params": {
        "outputChannels": 2,
        "channelInterpretation": "speakers"
      }
    },
    {
      "id": "emit",
      "kind": "emitter",
      "params": {
        "emitterType": "global",
        "gain": 1
      }
    }
  ],
  "connections": [
    {
      "from": {
        "node": "osc"
      },
      "to": {
        "node": "mix"
      }
    },
    {
      "from": {
        "node": "mix"
      },
      "to": {
        "node": "emit"
      }
    }
  ]
}