{
  "nodes": [
    { "id": "osc", "kind": "oscillator", "params": { "type": "sine", "frequency": 330, "startTime": 0 } },
    { "id": "lp", "kind": "biquad-filter", "params": { "type": "lowpass", "frequency": 1800, "Q": 0.7 } },
    { "id": "delay", "kind": "delay", "params": { "maxDelayTime": 1, "delayTime": 0.12 } },
    { "id": "conv", "kind": "convolver", "params": { "normalize": true } },
    { "id": "dry", "kind": "gain", "params": { "gain": 0.7 } },
    { "id": "wet", "kind": "gain", "params": { "gain": 0.3 } },
    { "id": "mix", "kind": "audio-mixer", "params": {} },
    { "id": "emit", "kind": "emitter", "params": { "emitterType": "global", "gain": 1 } }
  ],
  "connections": [
    { "from": { "node": "osc" }, "to": { "node": "lp" } },
    { "from": { "node": "lp" }, "to": { "node": "delay" } },
    { "from": { "node": "delay" }, "to": { "node": "dry" } },
    { "from": { "node": "delay" }, "to": { "node": "conv" } },
    { "from": { "node": "conv" }, "to": { "node": "wet" } },
    { "from": { "node": "dry" }, "to": { "node": "mix" } },
    { "from": { "node": "wet" }, "to": { "node": "mix" } },
    { "from": { "node": "mix" }, "to": { "node": "emit" } }
  ]
}

